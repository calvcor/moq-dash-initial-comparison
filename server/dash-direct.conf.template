# Puerto directo de LL-DASH: el navegador llega aquí a través del router, sin proxy intermedio, así que
# su propia conexión TCP es la que atraviesa la red emulada (como la de MoQ y la de WebRTC).
# Solo HTTP/1.1, como el camino a través del punto de entrada: HTTP/2 metería vídeo y audio en una
# misma conexión TCP y cambiaría lo que se mide.
server {
    listen 443 ssl;
    server_name __HOST__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location /media/dash/ {
        resolver 127.0.0.11 valid=10s;
        set $origin http://orchestrator:8000;
        proxy_pass $origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # El origen arma la URL de UTCTiming con el Origin de la página: hay que reenviarlo
        proxy_set_header Origin $http_origin;
        proxy_buffering off;
        proxy_cache off;
        add_header Timing-Allow-Origin "*" always;
    }

    location / {
        return 404;
    }
}
